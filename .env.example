# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real secrets.

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# From the Neon console → Connect. Use the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
